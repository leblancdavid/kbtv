        {"id": "ufos_questionable_truck_driver_vern_depressed_1", "text": "KBTV, Vern here. Go ahead.", "voiceText": "KBTV, Vern here. Go ahead.", "mood": "depressed"},
        {"id": "ufos_questionable_truck_driver_vern_angry_1", "text": "YOU'RE ON THE AIR! WHAT DO YOU WANT?!", "voiceText": "YOU'RE ON THE AIR! WHAT DO YOU WANT?!", "mood": "angry"},
        {"id": "ufos_questionable_truck_driver_vern_frustrated_1", "text": "Ugh, you're on.", "voiceText": "Ugh, you're on.", "mood": "frustrated"},
        {"id": "ufos_questionable_truck_driver_vern_obsessive_1", "text": "You're on KBTV. Tell me your experience.", "voiceText": "You're on KBTV. Tell me your experience.", "mood": "obsessive"},
        {"id": "ufos_questionable_truck_driver_vern_manic_1", "text": "KBTV!!!", "voiceText": "KBTV!!!", "mood": "manic"}
      ]
